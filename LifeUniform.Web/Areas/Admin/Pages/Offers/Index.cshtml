@page
@model LifeUniform.Web.Areas.Admin.Pages.Offers.IndexModel
@{
    ViewData["Title"] = "Рекламные предложения";
}

<div class="admin-page-head">
    <div>
        <h1>Реклама</h1>
        <p>Баннеры и спецпредложения на главной</p>
    </div>
</div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <form method="post" class="admin-card">
                <div class="admin-card__body">
                    <h2 class="h6 fw-bold mb-3">@(Model.Input.Id is null ? "Создать" : "Редактировать")</h2>
                    <input type="hidden" asp-for="Input.Id" />
                    <div class="mb-2">
                        <label asp-for="Input.Title" class="form-label"></label>
                        <input asp-for="Input.Title" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Subtitle" class="form-label"></label>
                        <input asp-for="Input.Subtitle" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Badge" class="form-label"></label>
                        <input asp-for="Input.Badge" class="form-control" placeholder="Спецпредложение" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.ImageUrl" class="form-label"></label>
                        <input asp-for="Input.ImageUrl" class="form-control" />
                        <div class="form-text">Напр. /images/hero-banner.png</div>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.LinkUrl" class="form-label"></label>
                        <input asp-for="Input.LinkUrl" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.LinkText" class="form-label"></label>
                        <input asp-for="Input.LinkText" class="form-control" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label asp-for="Input.Price" class="form-label"></label>
                            <input asp-for="Input.Price" class="form-control" />
                        </div>
                        <div class="col">
                            <label asp-for="Input.OldPrice" class="form-label"></label>
                            <input asp-for="Input.OldPrice" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.SortOrder" class="form-label"></label>
                        <input asp-for="Input.SortOrder" class="form-control" />
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    @if (Model.Input.Id is not null)
                    {
                        <a class="btn btn-link" asp-page="./Index">Сброс</a>
                    }
                </div>
            </form>
        </div>
        <div class="col-lg-7">
            <div class="admin-card">
                <div class="admin-card__body--flush">
                    <div class="table-responsive">
                        <table class="table admin-table mb-0">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Заголовок</th>
                                    <th>Активен</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.Vm.Count == 0)
                            {
                                <tr><td colspan="4" class="admin-empty">Пока нет предложений</td></tr>
                            }
                            else
                            {
                                @foreach (var o in Model.Vm)
                                {
                                    <tr>
                                        <td style="width:72px;">
                                            <img src="@o.ImageUrl" alt="" loading="lazy" style="width:64px;height:48px;object-fit:cover;" class="rounded" />
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@o.Title</div>
                                            <div class="small text-muted">@o.Badge</div>
                                        </td>
                                        <td>
                                            @if (o.IsActive)
                                            {
                                                <span class="admin-badge admin-badge--ok">Да</span>
                                            }
                                            else
                                            {
                                                <span class="admin-badge admin-badge--muted">Нет</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="admin-actions">
                                                <a class="btn btn-sm btn-outline-secondary" asp-route-editId="@o.Id">Изменить</a>
                                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                                    <input type="hidden" name="id" value="@o.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Удалить?')">Удалить</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
