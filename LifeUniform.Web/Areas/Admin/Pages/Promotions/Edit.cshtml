@page "{id:guid}"
@model LifeUniform.Web.Areas.Admin.Pages.Promotions.EditModel
@using LifeUniform.Domain.Promotions
@{
    ViewData["Title"] = "Редактировать промокод";
}

@if (Model.IsNotFound)
{
    <div class="alert alert-warning">Промокод не найден.</div>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h4 fw-bold mb-0">Редактировать промокод</h1>
        <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-page="/Promotions/Index">К списку</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post" class="card shadow-sm" style="max-width:520px;">
        <div class="card-body">
            <input type="hidden" asp-for="Input.Id" />
            <div class="mb-3">
                <label asp-for="Input.Code" class="form-label"></label>
                <input asp-for="Input.Code" class="form-control" />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Type" class="form-label"></label>
                <select asp-for="Input.Type" class="form-select">
                    <option value="@((int)PromotionDiscountType.Percent)">Процент</option>
                    <option value="@((int)PromotionDiscountType.Fixed)">Фиксированная сумма</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Value" class="form-label"></label>
                <input asp-for="Input.Value" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.MinOrderAmount" class="form-label"></label>
                <input asp-for="Input.MinOrderAmount" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.MaxRedemptions" class="form-label"></label>
                <input asp-for="Input.MaxRedemptions" class="form-control" />
                <div class="form-text">Уже использовано: @Model.Input.RedemptionCount</div>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary">Сохранить</button>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
