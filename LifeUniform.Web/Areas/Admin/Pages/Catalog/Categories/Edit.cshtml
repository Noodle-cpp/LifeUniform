@page "{slug}"
@model LifeUniform.Web.Areas.Admin.Pages.Catalog.Categories.EditModel

@{
    ViewData["Title"] = $"Редактирование категории (админ) — {Model.Vm?.Name ?? ""}";
}

<h1 class="h4 fw-bold mb-3">Редактировать категорию</h1>

@if (Model.IsNotFound)
{
    <div class="alert alert-warning">Категория не найдена.</div>
}
else
{
    <form method="post" class="card p-3 shadow-sm">
        <input type="hidden" name="Vm.Slug" value="@Model.Vm.Slug" />

        <div class="mb-3">
            <label class="form-label">Название</label>
            <input class="form-control" asp-for="Vm.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Пол</label>
            <select class="form-select" asp-for="Vm.Gender">
                <option value="1">Женское</option>
                <option value="2">Мужское</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">SortOrder</label>
            <input class="form-control" type="number" asp-for="Vm.SortOrder" />
        </div>

        <div class="mb-3">
            <label class="form-label">Описание</label>
            <textarea class="form-control" asp-for="Vm.Description"></textarea>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" asp-for="Vm.IsActive" />
            <label class="form-check-label" asp-for="Vm.IsActive">Активна</label>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Сохранить</button>
            <a class="btn btn-outline-secondary" asp-page="/Catalog/Categories/Index">Отмена</a>
        </div>
    </form>
}

