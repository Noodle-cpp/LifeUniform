@page
@model LifeUniform.Web.Areas.Admin.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = "Товары";
}

<div class="admin-page-head">
    <div>
        <h1>Товары</h1>
        <p>Каталог магазина: цены, размеры и карточки</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-page="/Catalog/Categories/Index">Категории</a>
        <a class="btn btn-primary" asp-area="Admin" asp-page="/Catalog/Products/Create">
            <i class="bi bi-plus-lg me-1"></i> Добавить товар
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card__body--flush">
        @if (Model.Vm.Count == 0)
        {
            <div class="admin-empty">Товаров пока нет. Добавьте первый.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0">
                    <thead>
                        <tr>
                            <th>Товар</th>
                            <th>Категория</th>
                            <th>Пол</th>
                            <th class="text-end">Цена</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Vm)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@p.Name</div>
                                <div class="text-muted small">@p.Slug</div>
                            </td>
                            <td>@p.CategoryName</td>
                            <td>
                                <span class="admin-badge">
                                    @(((LifeUniform.Domain.Catalog.ProductGender)p.Gender) == LifeUniform.Domain.Catalog.ProductGender.Women ? "Женское" : "Мужское")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (p.DiscountPrice != null)
                                {
                                    <div class="text-muted text-decoration-line-through small">@p.Price.ToString("N0") ₽</div>
                                    <div class="fw-bold">@p.DiscountPrice.Value.ToString("N0") ₽</div>
                                }
                                else
                                {
                                    <div class="fw-bold">@p.Price.ToString("N0") ₽</div>
                                }
                            </td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-page="/Catalog/EditSizes"
                                       asp-area="Admin"
                                       asp-route-slug="@p.Slug">Размеры</a>
                                    <a class="btn btn-sm btn-primary"
                                       asp-page="/Catalog/Products/Edit"
                                       asp-area="Admin"
                                       asp-route-slug="@p.Slug">Изменить</a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
