@page
@model LifeUniform.Web.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container py-4">
<h1 class="h3 fw-bold mb-2">Личный кабинет</h1>
<p class="text-muted mb-4">@User.Identity?.Name</p>

<div class="row g-3">
    <div class="col-md-4">
        <a class="category-tile h-100" asp-page="/Account/Orders">
            <div class="fw-semibold">Мои заказы</div>
            <div class="small text-muted mt-1">История и оплата</div>
        </a>
    </div>
    <div class="col-md-4">
        <a class="category-tile h-100" asp-page="/Favorites/Index">
            <div class="fw-semibold">Избранное</div>
            <div class="small text-muted mt-1">Сохранённые товары</div>
        </a>
    </div>
    <div class="col-md-4">
        <a class="category-tile h-100" asp-page="/Cart/Index">
            <div class="fw-semibold">Корзина</div>
            <div class="small text-muted mt-1">Текущий заказ</div>
        </a>
    </div>
</div>
</div>
