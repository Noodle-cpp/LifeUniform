@page
@model LifeUniform.Web.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container py-4 py-lg-5">
    <section class="account-hero">
        <div class="account-hero__top">
            <p class="account-hero__eyebrow">Кабинет</p>
            <form method="post" asp-page="/Account/Logout" asp-route-returnUrl="/">
                <button type="submit" class="section-link account-logout">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    Выйти
                </button>
            </form>
        </div>
        <h1 class="account-hero__title">@Model.Greeting</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <p class="account-hero__email">@Model.Email</p>
        }
        <a class="account-hero__edit" asp-page="/Account/Profile">Редактировать профиль</a>
    </section>

    <div class="account-grid">
        <a class="account-card" asp-page="/Account/Orders">
            <span class="account-card__icon" aria-hidden="true"><i class="bi bi-receipt"></i></span>
            <span class="account-card__title">Мои заказы</span>
            <span class="account-card__stat">@Model.OrdersLabel</span>
            <span class="account-card__go">История и оплата</span>
        </a>
        <a class="account-card" asp-page="/Favorites/Index">
            <span class="account-card__icon" aria-hidden="true"><i class="bi bi-heart"></i></span>
            <span class="account-card__title">Избранное</span>
            <span class="account-card__stat">@Model.FavoritesLabel</span>
            <span class="account-card__go">Сохранённые модели</span>
        </a>
        <a class="account-card" asp-page="/Cart/Index">
            <span class="account-card__icon" aria-hidden="true"><i class="bi bi-bag"></i></span>
            <span class="account-card__title">Корзина</span>
            <span class="account-card__stat">@Model.CartLabel</span>
            <span class="account-card__go">@(Model.CartCount > 0 ? "Оформить заказ" : "Открыть корзину")</span>
        </a>
    </div>

    @if (Model.LastOrder is not null)
    {
        <a class="account-last" asp-page="/Account/Orders">
            <div>
                <div class="account-last__eyebrow">Последний заказ</div>
                <div class="account-last__title">@Model.LastOrder.Number</div>
                <div class="account-last__meta">
                    <span>@Model.LastOrderDate</span>
                    <span>@Model.LastOrderStatus</span>
                </div>
            </div>
            <div class="account-last__side">
                <strong>@Model.LastOrder.GrandTotal.ToString("N0") ₽</strong>
                <span class="account-card__go">Все заказы</span>
            </div>
        </a>
    }
</div>
