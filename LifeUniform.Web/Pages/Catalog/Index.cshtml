@page
@model LifeUniform.Web.Pages.Catalog.IndexModel
@using LifeUniform.Domain.Catalog
@{
    ViewData["Title"] = "Каталог";
    var page = Model.Vm.Page;
    var totalPages = Model.Vm.TotalPages;
}

<div class="container py-4">
<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Каталог</h1>
        <p class="text-muted mb-0">Медицинская одежда для ежедневной практики</p>
    </div>
    <form method="get" class="d-flex gap-2" style="min-width: min(100%, 320px);">
        @if (Model.Gender is not null)
        {
            <input type="hidden" name="gender" value="@Model.Gender" />
        }
        @if (Model.CategoryId is not null)
        {
            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
        }
        <input type="search"
               name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Поиск…" />
        <button type="submit" class="btn btn-primary">Найти</button>
    </form>
</div>

<div class="mb-3 d-flex flex-wrap gap-2">
    <a class="btn btn-sm @(Model.Gender is null ? "btn-primary" : "btn-outline-secondary")"
       asp-page="/Catalog/Index"
       asp-route-categoryId="@Model.CategoryId"
       asp-route-search="@Model.Search">Все</a>
    <a class="btn btn-sm @(Model.Gender == (int)ProductGender.Women ? "btn-primary" : "btn-outline-secondary")"
       asp-page="/Catalog/Index"
       asp-route-gender="@((int)ProductGender.Women)"
       asp-route-categoryId="@Model.CategoryId"
       asp-route-search="@Model.Search">Женское</a>
    <a class="btn btn-sm @(Model.Gender == (int)ProductGender.Men ? "btn-primary" : "btn-outline-secondary")"
       asp-page="/Catalog/Index"
       asp-route-gender="@((int)ProductGender.Men)"
       asp-route-categoryId="@Model.CategoryId"
       asp-route-search="@Model.Search">Мужское</a>
</div>

@if (Model.Vm.Categories.Count > 0)
{
    <div class="mb-4 d-flex flex-wrap gap-2">
        <a class="chip @(Model.CategoryId is null ? "chip-active" : null)"
           asp-page="/Catalog/Index"
           asp-route-gender="@Model.Gender"
           asp-route-search="@Model.Search">Все категории</a>
        @foreach (var c in Model.Vm.Categories)
        {
            <a class="chip @(Model.CategoryId == c.Id ? "chip-active" : null)"
               asp-page="/Catalog/Index"
               asp-route-gender="@Model.Gender"
               asp-route-categoryId="@c.Id"
               asp-route-search="@Model.Search">@c.Name</a>
        }
    </div>
}

@if (Model.Vm.Items.Count == 0)
{
    <div class="empty-state card shadow-sm border-0 p-4 text-center">
        <div class="fw-semibold mb-1">Ничего не нашлось</div>
        <p class="text-muted mb-3">Попробуйте сменить фильтр или сбросить поиск.</p>
        <a class="btn btn-outline-primary" asp-page="/Catalog/Index">Сбросить фильтры</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model.Vm.Items)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <partial name="_ProductCard" model="p" />
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Страницы каталога">
            <ul class="pagination justify-content-center mb-0">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : null)">
                        <a class="page-link"
                           asp-page="/Catalog/Index"
                           asp-route-gender="@Model.Gender"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-search="@Model.Search"
                           asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
</div>
