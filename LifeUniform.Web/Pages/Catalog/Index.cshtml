@page
@model LifeUniform.Web.Pages.Catalog.IndexModel
@using LifeUniform.Domain.Catalog
@{
    var gender = Model.Gender;
    var isWomen = gender == (int)ProductGender.Women;
    var isMen = gender == (int)ProductGender.Men;
    ViewData["Title"] = isWomen ? "Для женщин" : isMen ? "Для мужчин" : "Каталог";
    var page = Model.Vm.Page;
    var totalPages = Model.Vm.TotalPages;
    var heading = isWomen ? "Для женщин" : isMen ? "Для мужчин" : "Каталог";
    var parentLabel = isWomen ? "Женская одежда" : isMen ? "Мужская одежда" : "Все модели";
    var allCta = isWomen ? "Все товары для женщин" : isMen ? "Все товары для мужчин" : "Все товары";
}

<div class="site-wrap catalog-page">
    <a class="btn btn-primary catalog-page__all d-md-none"
       asp-page="/Catalog/Index"
       asp-route-gender="@gender">@allCta</a>

    <div class="catalog-page__head d-none d-md-flex">
        <h1 class="catalog-page__title">@heading</h1>
    </div>

    <div class="catalog-layout">
        <aside class="catalog-filters">
            @if (Model.Vm.AvailableColors.Count > 0)
            {
                <div class="catalog-filters__block">
                    <div class="catalog-filters__title">Цвет</div>
                    <div class="color-dots color-dots--lg">
                        @foreach (var c in Model.Vm.AvailableColors)
                        {
                            var selected = string.Equals(Model.Color, c.Name, StringComparison.OrdinalIgnoreCase);
                            <a class="color-dot @(selected ? "is-selected" : null)"
                               style="background:@c.Hex"
                               title="@c.Name"
                               asp-page="/Catalog/Index"
                               asp-route-gender="@gender"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-color="@(selected ? null : c.Name)"
                               aria-label="Цвет @c.Name"></a>
                        }
                    </div>
                </div>
            }

            <div class="catalog-filters__block">
                <div class="catalog-filters__title">Модель</div>
                <a class="catalog-check @(Model.CategoryId is null ? "is-on" : null)"
                   asp-page="/Catalog/Index"
                   asp-route-gender="@gender"
                   asp-route-color="@Model.Color">
                    <span class="catalog-check__box"></span>
                    @parentLabel
                </a>
                @if (Model.Vm.Categories.Count > 0)
                {
                    <div class="catalog-check__children">
                        @foreach (var c in Model.Vm.Categories)
                        {
                            var on = Model.CategoryId == c.Id;
                            <a class="catalog-check @(on ? "is-on" : null)"
                               asp-page="/Catalog/Index"
                               asp-route-gender="@gender"
                               asp-route-categoryId="@(on ? null : c.Id)"
                               asp-route-color="@Model.Color">
                                <span class="catalog-check__box"></span>
                                @c.Name
                            </a>
                        }
                    </div>
                }
            </div>
        </aside>

        <div class="catalog-products">
            @if (Model.Vm.Items.Count == 0)
            {
                <div class="empty-state card shadow-sm border-0 p-4 text-center">
                    <div class="fw-semibold mb-1">Ничего не нашлось</div>
                    <p class="text-muted mb-3">Попробуйте сменить фильтр.</p>
                    <a class="btn btn-outline-primary" asp-page="/Catalog/Index" asp-route-gender="@gender">Сбросить фильтры</a>
                </div>
            }
            else
            {
                <div class="catalog-products__rail" data-rail>
                    <button type="button" class="product-rail__nav product-rail__nav--prev d-md-none" aria-label="Назад">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="catalog-products__track product-rail__track">
                        @foreach (var p in Model.Vm.Items)
                        {
                            <div class="catalog-products__item">
                                <partial name="_ProductCard" model="p" />
                            </div>
                        }
                    </div>
                    <button type="button" class="product-rail__nav product-rail__nav--next d-md-none" aria-label="Вперёд">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>

                @if (totalPages > 1)
                {
                    <nav class="mt-4 catalog-pager" aria-label="Страницы каталога">
                        <ul class="pagination justify-content-center mb-0">
                            @for (var i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == page ? "active" : null)">
                                    <a class="page-link"
                                       asp-page="/Catalog/Index"
                                       asp-route-gender="@gender"
                                       asp-route-categoryId="@Model.CategoryId"
                                       asp-route-color="@Model.Color"
                                       asp-route-page="@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
