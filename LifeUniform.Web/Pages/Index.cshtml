@page
@model IndexModel
@{
    ViewData["Title"] = "Life Uniform — медицинская одежда";
    const string heroWords = "удобная,стильная,лёгкая,практичная,комфортная,современная,изящная,дышащая";
}

<section class="hero-banner">
    <div class="hero-banner__stage">
        @* Desktop: one full-bleed image *@
        <div class="hero-banner__shot hero-banner__shot--full media-frame media-frame--hero is-loading">
            <span class="media-loader" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
            <img src="~/images/hero-banner.png"
                 alt="Life Uniforms — медицинская одежда"
                 class="hero-banner__img js-lazy-img"
                 loading="eager"
                 asp-append-version="true" />
        </div>

        @* Mobile: left half on top (with text), right half below *@
        <div class="hero-banner__split">
            <div class="hero-banner__shot hero-banner__shot--left media-frame is-loading">
                <span class="media-loader" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
                <img src="~/images/hero-banner.png"
                     alt="Life Uniforms — медицинская одежда"
                     class="hero-banner__img js-lazy-img"
                     loading="eager"
                     asp-append-version="true" />
                <div class="hero-banner__overlay hero-banner__overlay--mobile">
                    <div class="site-wrap hero-banner__content">
                        <p class="brand-eyebrow mb-2 js-reveal">Life Uniforms</p>
                        <h1 class="hero-banner__title" aria-label="удобная медицинская одежда">
                            <span class="js-typewriter" data-words="@heroWords"></span>
                            <span class="hero-banner__title-static">медицинская одежда</span>
                        </h1>
                        <p class="hero-banner__lead js-reveal" data-reveal-delay="120">Стандарт качества современной медицинской формы</p>
                        <div class="hero-banner__actions d-flex flex-wrap gap-2 mt-3 js-reveal" data-reveal-delay="240">
                            <a class="btn btn-outline-primary btn-lg" asp-page="/Catalog/Index" asp-route-gender="1">Для женщин</a>
                            <a class="btn btn-outline-primary btn-lg" asp-page="/Catalog/Index" asp-route-gender="2">Для мужчин</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="hero-banner__shot hero-banner__shot--right media-frame is-loading">
                <span class="media-loader" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
                <img src="~/images/hero-banner.png"
                     alt=""
                     class="hero-banner__img js-lazy-img"
                     loading="eager"
                     asp-append-version="true" />
            </div>
        </div>

        <div class="hero-banner__overlay hero-banner__overlay--desktop">
            <div class="site-wrap hero-banner__content">
                <p class="brand-eyebrow mb-2 js-reveal">Life Uniforms</p>
                <h1 class="hero-banner__title" aria-label="удобная медицинская одежда">
                    <span class="js-typewriter" data-words="@heroWords"></span>
                    <span class="hero-banner__title-static">медицинская одежда</span>
                </h1>
                <p class="hero-banner__lead js-reveal" data-reveal-delay="120">Стандарт качества современной медицинской формы</p>
                <div class="hero-banner__actions d-flex flex-wrap gap-2 mt-3 js-reveal" data-reveal-delay="240">
                    <a class="btn btn-outline-primary btn-lg" asp-page="/Catalog/Index" asp-route-gender="1">Для женщин</a>
                    <a class="btn btn-outline-primary btn-lg" asp-page="/Catalog/Index" asp-route-gender="2">Для мужчин</a>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-banner__features js-reveal" data-reveal-delay="360">
        <div class="site-wrap">
            <div class="hero-features-bar">
                <div class="hero-feature">
                    <i class="bi bi-gem"></i>
                    <div>
                        <div class="fw-bold">Премиум качество</div>
                        <div class="small text-muted">Безупречное исполнение в каждой детали</div>
                    </div>
                </div>
                <div class="hero-feature">
                    <i class="bi bi-layers"></i>
                    <div>
                        <div class="fw-bold">Технологичная ткань</div>
                        <div class="small text-muted">Дышащие, износостойкие и лёгкие материалы</div>
                    </div>
                </div>
                <div class="hero-feature">
                    <i class="bi bi-person-walking"></i>
                    <div>
                        <div class="fw-bold">Комфорт в движении</div>
                        <div class="small text-muted">Эргономичный крой для свободы движений</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="site-wrap py-5">
    @{
        ViewData["RailTitle"] = "Для женщин";
        ViewData["RailCta"] = "Все товары для женщин";
        ViewData["RailGender"] = 1;
    }
    <div class="js-reveal">
        <partial name="_ProductRail" model="Model.Vm.WomenProducts" />
    </div>

    @if (Model.Vm.PromoOffers.Count > 0)
    {
        <section class="promo-rail-section js-reveal" data-rail data-rail-auto>
            <div class="product-rail-section__head">
                <h2 class="section-title mb-0">Спецпредложения</h2>
                <div class="client-photos__nav">
                    <button type="button" class="product-rail__nav product-rail__nav--prev" aria-label="Назад">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button type="button" class="product-rail__nav product-rail__nav--next" aria-label="Вперёд">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div class="product-rail__track">
                @foreach (var offer in Model.Vm.PromoOffers)
                {
                    var discountPct = offer.Price is decimal p && offer.OldPrice is decimal o && o > p
                        ? (int)Math.Round((1 - p / o) * 100)
                        : (int?)null;
                    <a class="promo-slide" href="@(offer.LinkUrl ?? "/Catalog")">
                        <span class="media-frame media-frame--fill is-loading">
                            <span class="media-loader" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
                            <img src="@offer.ImageUrl" alt="@offer.Title" class="js-lazy-img" loading="lazy" />
                        </span>
                        <span class="promo-slide__scrim"></span>
                        <span class="promo-slide__caption">
                            @if (!string.IsNullOrWhiteSpace(offer.Badge))
                            {
                                <span class="promo-slide__badge">@offer.Badge</span>
                            }
                            else if (discountPct is int pct && pct > 0)
                            {
                                <span class="promo-slide__badge">−<span class="js-count-up" data-value="@pct" data-suffix="%">0%</span></span>
                            }
                            <span class="promo-slide__title">@offer.Title</span>
                            @if (!string.IsNullOrWhiteSpace(offer.Subtitle))
                            {
                                <span class="promo-slide__sub">@offer.Subtitle</span>
                            }
                            @if (offer.Price is not null || offer.OldPrice is not null)
                            {
                                <span class="promo-slide__price">
                                    @if (offer.Price is not null)
                                    {
                                        <strong><span class="js-count-up" data-value="@offer.Price.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-suffix=" ₽">0 ₽</span></strong>
                                    }
                                    @if (offer.OldPrice is not null)
                                    {
                                        <s>@offer.OldPrice.Value.ToString("0.##") ₽</s>
                                    }
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(offer.LinkText))
                            {
                                <span class="promo-slide__cta">@offer.LinkText</span>
                            }
                        </span>
                    </a>
                }
            </div>
        </section>
    }

    @{
        ViewData["RailTitle"] = "Для мужчин";
        ViewData["RailCta"] = "Все товары для мужчин";
        ViewData["RailGender"] = 2;
    }
    <div class="js-reveal">
        <partial name="_ProductRail" model="Model.Vm.MenProducts" />
    </div>

    <div class="js-reveal">
        <partial name="_ClientPhotos" model="Model.Vm.ClientPhotos" />
    </div>
</div>
