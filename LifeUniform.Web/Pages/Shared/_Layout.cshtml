<!DOCTYPE html>
<html lang="ru">
@using LifeUniform.Domain.Cart
@inject ICartService CartService
@{
    var cartQty = CartService.GetItems().Sum(x => x.Quantity);
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Life Uniforms</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LifeUniform.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light site-nav border-bottom">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">Life Uniforms</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Catalog/Index">Каталог</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Catalog/Index" asp-route-gender="1">Женское</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Catalog/Index" asp-route-gender="2">Мужское</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-1 nav-icons">
                        <li class="nav-item">
                            <a class="nav-link nav-icon" asp-page="/Catalog/Index" title="Поиск" aria-label="Поиск">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <span class="nav-icon__label">Поиск</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-icon" asp-page="/Favorites/Index" title="Избранное" aria-label="Избранное">
                                <i class="bi bi-heart" aria-hidden="true"></i>
                                <span class="nav-icon__label">Избранное</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-icon nav-cart"
                               asp-page="/Cart/Index"
                               title="Корзина"
                               aria-label="@(cartQty > 0 ? $"Корзина, {cartQty}" : "Корзина")">
                                <i class="bi bi-bag" aria-hidden="true"></i>
                                <span class="nav-icon__label">Корзина</span>
                                @if (cartQty > 0)
                                {
                                    <span class="nav-cart__count">@(cartQty > 99 ? "99+" : cartQty.ToString())</span>
                                }
                            </a>
                        </li>
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Админ</a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-area="Admin" asp-page="/Index">Главная</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-page="/Catalog/Index">Товары</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-page="/Orders/Index">Заказы</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-page="/Promotions/Index">Промокоды</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-page="/Offers/Index">Реклама</a></li>
                                    </ul>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link nav-icon" asp-page="/Account/Index" title="Кабинет" aria-label="Кабинет">
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                    <span class="nav-icon__label">Кабинет</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                                    <button type="submit" class="nav-link nav-icon btn btn-link" title="Выйти" aria-label="Выйти">
                                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                        <span class="nav-icon__label">Выйти</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-icon" href="#loginModal" data-bs-toggle="modal" data-bs-target="#loginModal" title="Вход" aria-label="Вход">
                                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                                    <span class="nav-icon__label">Вход</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-icon" href="#registerModal" data-bs-toggle="modal" data-bs-target="#registerModal" title="Регистрация" aria-label="Регистрация">
                                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                                    <span class="nav-icon__label">Регистрация</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="fw-bold mb-2 text-uppercase" style="letter-spacing:0.06em">Life Uniforms</div>
                    <p class="small mb-0 footer-muted">Медицинская одежда премиум-класса для ежедневной практики.</p>
                </div>
                <div class="col-6 col-md-2">
                    <div class="fw-semibold mb-2">Меню</div>
                    <ul class="list-unstyled small footer-links">
                        <li><a asp-page="/Index">Главная</a></li>
                        <li><a asp-page="/Catalog/Index">Каталог</a></li>
                        <li><a asp-page="/Catalog/Index" asp-route-gender="1">Женское</a></li>
                        <li><a asp-page="/Catalog/Index" asp-route-gender="2">Мужское</a></li>
                        <li><a asp-page="/Delivery">Доставка</a></li>
                        <li><a asp-page="/Cart/Index">Корзина</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fw-semibold mb-2">Контакты</div>
                    <ul class="list-unstyled small footer-muted mb-0">
                        <li class="mb-1"><i class="bi bi-telephone me-1"></i> +7 (900) 000-00-00</li>
                        <li class="mb-1"><i class="bi bi-envelope me-1"></i> hello@lifeuniforms.ru</li>
                        <li><i class="bi bi-geo-alt me-1"></i> Москва</li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <div class="fw-semibold mb-2">Соцсети</div>
                    <div class="d-flex gap-3 footer-social">
                        <a href="https://t.me/" target="_blank" rel="noopener" aria-label="Telegram"><i class="bi bi-telegram"></i></a>
                        <a href="https://vk.com/" target="_blank" rel="noopener" aria-label="VK"><i class="bi bi-vk"></i></a>
                        <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://wa.me/" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4" />
            <div class="d-flex flex-wrap justify-content-between gap-2 small footer-muted">
                <span>&copy; @DateTime.Now.Year Life Uniforms</span>
                <a asp-page="/Privacy">Политика конфиденциальности</a>
            </div>
        </div>
    </footer>

    @if (User?.Identity?.IsAuthenticated != true)
    {
        <partial name="_AuthModals" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (ViewData["OpenAuthModal"] is string openModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
              const id = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(openModal == "register" ? "registerModal" : "loginModal"));
              const el = document.getElementById(id);
              if (el && window.bootstrap) bootstrap.Modal.getOrCreateInstance(el).show();
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
