<!DOCTYPE html>
<html lang="ru">
@using LifeUniform.Domain.Cart
@inject ICartService CartService
@{
    var cartQty = CartService.GetItems().Sum(x => x.Quantity);
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Life Uniforms</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LifeUniform.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header sticky-top">
        <nav class="site-nav">
            <div class="site-wrap site-nav__inner">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">Life Uniforms</a>

                @await Component.InvokeAsync("HeaderNav")

                <div class="site-nav__actions">
                    <a class="nav-icon js-fav-target" asp-page="/Favorites/Index" title="Избранное" aria-label="Избранное">
                        <i class="bi bi-heart" aria-hidden="true"></i>
                    </a>
                    <button type="button" class="nav-icon nav-icon--btn js-search-open" title="Поиск" aria-label="Поиск">
                        <i class="bi bi-search" aria-hidden="true"></i>
                    </button>
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-icon" asp-page="/Account/Index" title="Кабинет" aria-label="Кабинет">
                            <i class="bi bi-person" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <a class="nav-icon" href="#loginModal" data-bs-toggle="modal" data-bs-target="#loginModal" title="Вход" aria-label="Вход">
                            <i class="bi bi-person" aria-hidden="true"></i>
                        </a>
                    }
                    <a class="nav-icon nav-cart js-cart-target"
                       asp-page="/Cart/Index"
                       title="Корзина"
                       aria-label="@(cartQty > 0 ? $"Корзина, {cartQty}" : "Корзина")">
                        <i class="bi bi-bag" aria-hidden="true"></i>
                        @if (cartQty > 0)
                        {
                            <span class="nav-cart__count">@(cartQty > 99 ? "99+" : cartQty.ToString())</span>
                        }
                    </a>
                    <button class="nav-icon nav-icon--btn nav-icon--menu d-lg-none js-nav-toggle"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNav"
                            aria-controls="mainNav"
                            aria-expanded="false"
                            aria-label="Меню">
                        <span class="nav-burger" aria-hidden="true">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                    </button>
                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <a class="nav-icon d-none d-lg-inline-flex" asp-area="Admin" asp-page="/Index" title="Админ" aria-label="Админ">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
            <div class="collapse site-nav__mobile" id="mainNav">
                <div class="site-wrap site-nav__mobile-inner">
                    @await Component.InvokeAsync("HeaderNav", new { variant = "Mobile" })
                    <a class="site-nav__mobile-link" asp-area="" asp-page="/Delivery">Доставка</a>
                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <a class="site-nav__mobile-link" asp-area="Admin" asp-page="/Index">Админ</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div id="searchOverlay" class="search-overlay" hidden>
        <div class="search-overlay__panel">
            <div class="search-overlay__top">
                <form class="search-overlay__form" id="searchOverlayForm" action="/Catalog/Search" method="get">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="searchOverlayInput" name="q" placeholder="Поиск" autocomplete="off" />
                    <button type="button" class="search-overlay__clear" id="searchOverlayClear" aria-label="Очистить" hidden>
                        <i class="bi bi-x" aria-hidden="true"></i>
                    </button>
                </form>
                <button type="button" class="search-overlay__close js-search-close" aria-label="Закрыть поиск">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="search-overlay__progress" id="searchOverlayProgress" hidden>
                <span class="search-overlay__progress-bar"></span>
            </div>
        </div>
        <div class="search-overlay__body">
            <div class="search-overlay__inner">
                <div id="searchOverlayMeta" class="search-overlay__meta"></div>
                <div id="searchOverlayEmpty" class="search-overlay__empty" hidden>
                    <div class="search-overlay__empty-face" aria-hidden="true">☹️</div>
                    <div class="search-overlay__empty-title">Товары не найдены</div>
                    <div class="search-overlay__empty-text">Попробуйте изменить запрос или проверить написание</div>
                </div>
                <div id="searchOverlayResults" class="search-overlay__grid"></div>
                <button type="button" id="searchOverlayMore" class="btn btn-outline-primary search-overlay__more" hidden>Показать ещё</button>
                <nav id="searchOverlayPager" class="search-overlay__pager" aria-label="Страницы поиска"></nav>
            </div>
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        <div class="site-wrap py-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="fw-bold mb-2 text-uppercase" style="letter-spacing:0.06em">Life Uniforms</div>
                    <p class="small mb-0 footer-muted">Медицинская одежда премиум-класса для ежедневной практики.</p>
                </div>
                <div class="col-6 col-md-2">
                    <div class="fw-semibold mb-2">Меню</div>
                    <ul class="list-unstyled small footer-links">
                        <li><a asp-page="/Index">Главная</a></li>
                        <li><a asp-page="/Catalog/Index">Каталог</a></li>
                        <li><a asp-page="/Catalog/Index" asp-route-gender="1">Женское</a></li>
                        <li><a asp-page="/Catalog/Index" asp-route-gender="2">Мужское</a></li>
                        <li><a asp-page="/Delivery">Доставка</a></li>
                        <li><a asp-page="/Cart/Index">Корзина</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fw-semibold mb-2">Контакты</div>
                    <ul class="list-unstyled small footer-muted mb-0">
                        <li class="mb-1"><i class="bi bi-telephone me-1"></i> +7 (900) 000-00-00</li>
                        <li class="mb-1"><i class="bi bi-envelope me-1"></i> hello@lifeuniforms.ru</li>
                        <li><i class="bi bi-geo-alt me-1"></i> Москва</li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <div class="fw-semibold mb-2">Соцсети</div>
                    <div class="d-flex gap-3 footer-social">
                        <a href="https://t.me/" target="_blank" rel="noopener" aria-label="Telegram"><i class="bi bi-telegram"></i></a>
                        <a href="https://vk.com/" target="_blank" rel="noopener" aria-label="VK"><i class="bi bi-vk"></i></a>
                        <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://wa.me/" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4" />
            <div class="d-flex flex-wrap justify-content-between gap-2 small footer-muted">
                <span>&copy; @DateTime.Now.Year Life Uniforms</span>
                <a asp-page="/Privacy">Политика конфиденциальности</a>
            </div>
        </div>
    </footer>

    @if (User?.Identity?.IsAuthenticated != true)
    {
        <partial name="_AuthModals" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (ViewData["OpenAuthModal"] is string openModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
              const id = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(openModal == "register" ? "registerModal" : "loginModal"));
              const el = document.getElementById(id);
              if (el && window.bootstrap) bootstrap.Modal.getOrCreateInstance(el).show();
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
