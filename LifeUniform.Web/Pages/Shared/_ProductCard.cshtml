@model LifeUniform.Application.Catalog.Dto.ProductCardDto

<div class="product-card h-100">
    <div class="product-card__media">
        <a asp-page="/Catalog/Details" asp-route-slug="@Model.Slug" class="product-card__img-link">
            <img class="js-product-card-img"
                 src="@Model.PreviewImageUrl"
                 data-default-src="@Model.PreviewImageUrl"
                 alt="@Model.Name"
                 loading="lazy"
                 @(Model.PreviewImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? "referrerpolicy=no-referrer" : null) />
        </a>
        <form method="post"
              asp-page="/Favorites/Toggle"
              asp-route-slug="@Model.Slug"
              class="product-card__fav js-favorite-form"
              data-slug="@Model.Slug">
            <button type="submit"
                    class="btn btn-sm product-fav-btn js-favorite-btn @(Model.IsFavorite ? "is-active" : null)"
                    title="@(Model.IsFavorite ? "В избранном" : "В избранное")"
                    aria-label="Избранное"
                    aria-pressed="@(Model.IsFavorite ? "true" : "false")"
                    data-favorite="@(Model.IsFavorite ? "true" : "false")">
                <i class="bi @(Model.IsFavorite ? "bi-heart-fill" : "bi-heart") js-favorite-icon"></i>
            </button>
        </form>
    </div>
    <div class="product-card__body">
        <div class="fw-semibold product-card__title">@Model.Name</div>
        <div class="mt-2">
            @if (Model.DiscountPrice != null)
            {
                <div class="text-muted text-decoration-line-through small">@($"{Model.Price:0.##} руб.")</div>
                <div class="fw-bold">@($"{Model.DiscountPrice:0.##} руб.")</div>
            }
            else
            {
                <div class="fw-bold">@($"{Model.Price:0.##} руб.")</div>
            }
        </div>
    </div>
    <div class="product-card__footer">
        @if (Model.Colors.Count > 0)
        {
            <div class="color-dots" aria-label="Цвета">
                @foreach (var c in Model.Colors.Take(5))
                {
                    var hasImage = !string.IsNullOrWhiteSpace(c.ImageUrl);
                    <a class="color-dot @(hasImage ? "js-color-preview" : null)"
                       style="background:@c.Hex"
                       title="@c.Name"
                       asp-page="/Catalog/Details"
                       asp-route-slug="@Model.Slug"
                       asp-route-color="@c.Name"
                       aria-label="Цвет @c.Name"
                       data-image="@(hasImage ? c.ImageUrl : null)"></a>
                }
            </div>
        }
        else
        {
            <div></div>
        }
        <a class="btn btn-sm btn-outline-primary" asp-page="/Catalog/Details" asp-route-slug="@Model.Slug">Смотреть</a>
    </div>
</div>

