@page "{token}"
@model LifeUniform.Web.Pages.Cart.PaymentModel
@using LifeUniform.Domain.Orders
@{
    ViewData["Title"] = "Оплата";
}

<div class="container py-4">
<h1 class="h4 fw-bold mb-3">Оплата заказа</h1>

@if (Model.IsNotFound || Model.Order is null)
{
    <div class="alert alert-warning">Заказ не найден.</div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Заказ</div>
                    <div class="fw-bold mb-2">@Model.Order.Number</div>
                    <div class="mb-1">Статус: <strong>@StatusLabel(Model.Order.Status)</strong></div>
                    <div class="mb-1">К оплате: <strong>@Model.Order.GrandTotal.ToString("0.##") руб.</strong></div>
                    @if (Model.Order.DiscountAmount > 0)
                    {
                        <div class="text-success small mb-1">
                            Скидка @(Model.Order.PromoCode is not null ? $"({Model.Order.PromoCode})" : ""): −@Model.Order.DiscountAmount.ToString("0.##") руб.
                        </div>
                    }
                    <div class="text-muted small">
                        Доставка: @(Model.Order.DeliveryMethod == DeliveryMethod.Cdek ? "СДЭК" : "Почта России")
                        (@Model.Order.DeliveryFee.ToString("0.##") руб.)
                    </div>
                </div>
            </div>

            @if (Model.Order.Status == OrderStatus.PendingPayment)
            {
                <form method="post" asp-page-handler="Confirm" class="mt-3">
                    <input type="hidden" name="token" value="@Model.Order.PaymentToken" />
                    <button type="submit" class="btn btn-success">Я оплатил (заглушка SBP/QR)</button>
                </form>
            }
            else
            {
                <a class="btn btn-outline-primary mt-3" asp-page="/Index">На главную</a>
            }
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="display-6 mb-2">QR</div>
                    <p class="text-muted mb-0">Заглушка QR/СБП. В проде здесь будет платёжный провайдер.</p>
                    <div class="mt-3 font-monospace small text-break">@Model.Order.PaymentToken</div>
                </div>
            </div>
        </div>
    </div>
}
</div>

@functions {
    static string StatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.PendingPayment => "Ожидает оплаты",
        OrderStatus.Paid => "Оплачен",
        OrderStatus.Shipped => "Отправлен",
        OrderStatus.Cancelled => "Отменён",
        _ => status.ToString()
    };
}
